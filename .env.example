# --- Discord ---
TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_guild_id
MONITOR_CHANNEL_ID=channel_id_for_boot_status_embed
LOG_CHANNEL_ID=channel_id_for_alert_messages
IMPORTANT_ROLE_ID=role_id_that_marks_critical_bots
ADMIN_USER_ID=your_discord_user_id

# --- Minecraft server ---
# Set to false to disable Minecraft monitoring and all related status features.
MC_ENABLE=true
MC_SERVER_IP=your.minecraft.server.ip
MC_SERVER_PORT=25565
MC_SERVER_NAME=Paper 1.21.11

# --- Monitoring cadence (seconds) ---
# How often a full monitoring cycle runs.
CHECK_INTERVAL=30
# Seconds a target must be continuously offline before being confirmed DOWN.
CONFIRM_DOWN_THRESHOLD=60

# --- "Still DOWN" reminder backoff ---
# First reminder step (seconds). Kept for backward compatibility.
CHECK_INTERVAL_DISPLAY_LOG=90
# Optional: fully override the escalating backoff schedule (comma-separated seconds).
# Defaults to "90,300,1800" (90s -> 5m -> 30m) when unset.
STILL_DOWN_BACKOFF=90,300,1800

# --- mcstatus.io retry/backoff ---
MC_MAX_RETRIES=3
MC_RETRY_BASE_MS=500
# Maximum time in milliseconds for one mcstatus.io request. Set to 0 to disable.
MC_STATUS_TIMEOUT_MS=10000

# --- Health-check HTTP endpoint ---
# Port for GET /health. Set to 0 to disable the server.
HEALTH_PORT=3000

# --- Daily uptime digest ---
# Cron expression (server local time) for the daily LOG_CHANNEL digest.
DAILY_DIGEST_CRON=0 1 * * *
