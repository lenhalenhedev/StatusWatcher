# --- Discord Bootstrap (required at process start) ---
TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_guild_id
ADMIN_USER_ID=your_discord_user_id

# --- Runtime settings ---
# Configure monitor/log channels, IMPORTANT_ROLE_ID, Minecraft servers,
# monitoring cadence, retry/backoff and daily digest through /config.
# These values are stored in SQLite and apply immediately without restart.

# --- Health-check HTTP endpoint ---
# Port for GET /health. Set to 0 to disable the server.
HEALTH_PORT=3000

# Required before configuring Database service monitoring; generate a random secret of at least 16 characters.
DB_ENCRYPTION_KEY=replace-with-a-long-random-secret

# DAILY_DIGEST_CRON is managed through /config and stored in SQLite.
